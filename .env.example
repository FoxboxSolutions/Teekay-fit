# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environnement d'exécution (M6/audit M4) — module unique src/lib/env.ts.
# development | preview | production.
# Défaut sûr si absente/invalide : argent/sécurité = comportement production
# (fake refusé, simulateur 404) ; indexation = noindex.
# build:prod et le job CI « content-strict » exigent APP_ENV=production
# explicite dans le shell (le script ne lit pas .env.local). Visible sur
# /api/health (appEnv).
APP_ENV=

# Supabase (jamais de vraies valeurs en Git)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stockage
STORAGE_BUCKET_PRIVATE=programs-private

# Auth : téléphone désactivé par défaut (feature flag)
AUTH_PHONE_ENABLED=false

# Sécurité des formulaires (M5)
# Sel du hachage IP des compteurs de rate limit (jamais d'IP en clair).
# OBLIGATOIRE dès qu'une instance est partagée : sinon chaque instance a un sel
# local et les limites par IP ne sont plus globales.
RATE_LIMIT_SALT=

# Cloudflare Turnstile — anti-spam, échec fermé (le secret manquant refuse tout).
# Dev/test : clés de test Cloudflare (valides sur localhost, échec fermé partout
# ailleurs) —
#   NEXT_PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Prod : clés du dashboard Cloudflare. Les clés de test acceptent n'importe quel
# jeton : leur usage hors localhost est explicitement refusé.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# WhatsApp — canal principal du site public (§7). Format international
# obligatoire : +213 suivi de 9 chiffres. build:prod échoue si absent/incorrect.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Placeholders — « true » affiche un cadre distinct autour des contenus
# [À FOURNIR …]. Dev/préprod uniquement ; la production les interdit (build:prod).
NEXT_PUBLIC_PLACEHOLDER_FRAMES=

# Paiement (M6/M7 — jamais de secret côté client)
PAYMENT_PROVIDER=
PAYMENT_API_BASE_URL=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Notifications e-mail (M10)
EMAIL_PROVIDER_API_KEY=

# Observabilité — vide par défaut, branché si renseigné
ERROR_TRACKING_DSN=

# Phase 2 (non utilisées en Phase 1)
FCM_SERVICE_ACCOUNT=
APNS_KEY=
